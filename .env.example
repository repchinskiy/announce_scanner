# Binance API credentials (read-only)
BINANCE_API_KEY=your_read_only_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# CryptoListing.ws keys (get via Telegram @CLWfeed)
CL_SPEEDTRIAL_TOKEN=dsk_your_speedtrial_key_here
CL_FREEDELAYED_TOKEN=dsk_your_freedelayed_key_here

# Telegram notifications (create bot via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890

# ---------------------------------------------------------------------------
# Channel selection
# ---------------------------------------------------------------------------
ENABLED_CHANNELS=all
#ENABLED_CHANNELS=all,!clws

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
ANN_CATALOG_IDS=0              # 0 = all categories; 48 = listings only
LOG_LEVEL=INFO
#LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# CMS pollers (apex, composite, catalog)
# ---------------------------------------------------------------------------
CMS_NUM_CACHE_KEYS=4
CMS_POLL_INTERVAL_S=5
CMS_POLL_FAST_INTERVAL_S=3
CMS_POLL_FAST_CYCLES=4
CMS_ADAPTIVE_TRIGGERS=Miss,RefreshHit
CMS_STATS_EVERY_CYCLES=500

COMPOSITE_POLL_INTERVAL_S=5
COMPOSITE_STATS_EVERY_CYCLES=500

CATALOG_POLL_INTERVAL_S=5

# Агрессивный режим (раскомментировать для минимальной задержки):
#CMS_POLL_INTERVAL_S=0.5
#CMS_POLL_FAST_INTERVAL_S=0.2
#CMS_POLL_FAST_CYCLES=10
#CMS_ADAPTIVE_TRIGGERS=Miss

# ---------------------------------------------------------------------------
# Exchange Info poller
# ---------------------------------------------------------------------------
EI_HOSTS=api.binance.com,api-gcp.binance.com,api4.binance.com,api2.binance.com
EI_STATS_EVERY_CYCLES=500

# ---------------------------------------------------------------------------
# Ticker sniper
# ---------------------------------------------------------------------------
SNIPER_HOSTS=api.binance.com,api-gcp.binance.com,api4.binance.com,api2.binance.com
SNIPER_STATS_EVERY_CYCLES=500
