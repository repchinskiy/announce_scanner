# Binance Announcements WebSocket client — credentials.
# Copy this file to .env and fill in real values.
#
# Create a read-only API key here (Enable Reading ONLY, no trading, no withdrawal):
#   https://www.binance.com/en/my/settings/api-management
#
# DO NOT commit .env to git. .gitignore already excludes it.

BINANCE_API_KEY=your_read_only_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# CryptoListing.ws keys (get via Telegram @CLWfeed)
CL_SPEEDTRIAL_TOKEN=dsk_your_speedtrial_key_here
CL_FREEDELAYED_TOKEN=dsk_your_freedelayed_key_here

# ---------------------------------------------------------------------------
# Telegram notifications (optional — notifier is a no-op if unset).
# Create a bot via @BotFather, then get chat id (negative for groups).
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890

# ---------------------------------------------------------------------------
# HTTP client backend (all pollers)
# ---------------------------------------------------------------------------
# Backend library: "aiohttp" (default) or "curl_cffi".
# curl_cffi can spoof TLS fingerprints (JA3/JA4) — needed if Cloudflare
# enters the picture. For current Binance endpoints (CloudFront), aiohttp
# is sufficient and slightly faster.
#HTTP_BACKEND=curl_cffi
# When HTTP_BACKEND=curl_cffi, which browser fingerprint to impersonate.
# Full list: chrome124, chrome146, firefox147, safari260, etc.
HTTP_CURL_IMPERSONATE=chrome146

# ---------------------------------------------------------------------------
# Channel selection (run.py)
# ---------------------------------------------------------------------------
# Comma-separated list of channels to start. Default: all channels.
# Valid: ws,cms_apex,cms_composite,cms_catalog,exchange,sniper,clws
# Special: "all" (alias for everything), "!name" to exclude one.
ENABLED_CHANNELS=all
#ENABLED_CHANNELS=all,!clws

# ---------------------------------------------------------------------------
# Shared channel config
# ---------------------------------------------------------------------------
# Catalog IDs to monitor for CMS pollers (default: 48 = New Cryptocurrency Listing).
# Set to 0 to monitor ALL announcement categories.
# Known categories:
#   48  -> New Cryptocurrency Listing
#   49  -> Latest Binance News
#   50  -> Latest Activities
#   51  -> Delistings
#   93  -> Latest Activities (alt)
#   128 -> P2P Merchant Announcements
#   157 -> Margin / Futures listings
#   161 -> Earn / Staking
ANN_CATALOG_IDS=0
#ANN_CATALOG_IDS=48,49,50,51,93,128,157,161
#ANN_CATALOG_IDS=48,49

# Log level (default: INFO). Use DEBUG for verbose output.
LOG_LEVEL=INFO
#LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Shared CMS cache-busting
# ---------------------------------------------------------------------------
# Number of random pageSize values (1..49) generated per poll cycle.
# More keys = higher probability of at least one CloudFront cache miss,
# but also more requests per second to Binance.
# Shares the same env var across cms_apex, cms_composite and cms_catalog pollers.
CMS_NUM_CACHE_KEYS=4

# ---------------------------------------------------------------------------
# CMS apex poller (cms_apex_poller.py)
# ---------------------------------------------------------------------------
# Apex CMS path /bapi/apex/.../article/list/query.
# Returns releaseDate (ms) — only CMS channel with publish timestamp.
#
# Base interval between poll cycles (seconds). Lower = more aggressive.
CMS_POLL_INTERVAL_S=5
# Fast interval used during a burst after a Miss/RefreshHit (seconds).
CMS_POLL_FAST_INTERVAL_S=3
# Number of fast cycles per burst trigger.
CMS_POLL_FAST_CYCLES=4
# Comma-separated cache statuses that trigger a fast burst.
# Options: Miss, RefreshHit (default: both).
CMS_ADAPTIVE_TRIGGERS=Miss,RefreshHit
# STATS log every N cycles (default 100; lower = more verbose).
CMS_STATS_EVERY_CYCLES=500

# Агрессивный режим (раскомментировать для минимальной задержки):
#CMS_POLL_INTERVAL_S=0.5
#CMS_POLL_FAST_INTERVAL_S=0.2
#CMS_POLL_FAST_CYCLES=10
#CMS_ADAPTIVE_TRIGGERS=Miss

# ---------------------------------------------------------------------------
# CMS composite poller (cms_composite_poller.py)
# ---------------------------------------------------------------------------
# Alternative CMS path /bapi/composite/.../article/catalog/list/query.
# No releaseDate — detection by article id only.
# Shares ANN_CATALOG_IDS and CMS_NUM_CACHE_KEYS with apex poller.
# Default conservative interval: Binance may IP-ban for aggressive CMS polling.
COMPOSITE_POLL_INTERVAL_S=5
COMPOSITE_STATS_EVERY_CYCLES=500

# ---------------------------------------------------------------------------
# CMS catalog poller (cms_apex_catalog_poller.py)
# ---------------------------------------------------------------------------
# Third CMS endpoint /bapi/apex/.../article/catalog/list/query (apex path,
# flat articles). No publishDate. Shares CMS_NUM_CACHE_KEYS.
CATALOG_POLL_INTERVAL_S=5

# ---------------------------------------------------------------------------
# exchangeInfo poller (exchangeinfo_poller.py)
# ---------------------------------------------------------------------------
# Polls Binance exchangeInfo endpoint for new trading symbols.
# Uses multiple hosts in parallel for reliability and speed:
#   api.binance.com       — CloudFront (default)
#   api-gcp.binance.com   — GCP GLB (no CloudFront, lower latency)
#   api4.binance.com      — direct nginx origin (lowest latency)
#   api2.binance.com      — direct nginx origin (lowest latency)
EI_HOSTS=api.binance.com,api-gcp.binance.com,api4.binance.com,api2.binance.com
EI_STATS_EVERY_CYCLES=500

# ---------------------------------------------------------------------------
# Ticker sniper (ticker_sniper.py)
# ---------------------------------------------------------------------------
# Polls GET /api/v3/ticker/price at high frequency and detects new
# tradable symbols by diffing the set. Lightweight (~150KB vs 17MB for
# exchangeInfo). Same multi-host pool as exchangeInfo poller.
# Default 1000ms (1 Hz) — conservative start. Tune aggressively once
# no 429 in production: 100ms (10 Hz), 50ms (20 Hz), 10ms (100 Hz).
SNIPER_HOSTS=api.binance.com,api-gcp.binance.com,api4.binance.com,api2.binance.com
SNIPER_STATS_EVERY_CYCLES=500
