# Binance Announcements WebSocket client — credentials.
# Copy this file to .env and fill in real values.
#
# Create a read-only API key here (Enable Reading ONLY, no trading, no withdrawal):
#   https://www.binance.com/en/my/settings/api-management
#
# DO NOT commit .env to git. .gitignore already excludes it.

BINANCE_API_KEY=your_read_only_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ---------------------------------------------------------------------------
# Channel selection (run.py)
# ---------------------------------------------------------------------------
# Comma-separated list of channels to start. Default: all channels.
# Valid: ws,cms,exchange,sniper,composite,clws
# Special: "all" (alias for everything), "!name" to exclude one.
# ENABLED_CHANNELS=all,!clws         # all except CLWS (while waiting for token)
# ENABLED_CHANNELS=ws,cms            # lightweight: only WS + CMS
# ENABLED_CHANNELS=ws,sniper         # WS + sniper only
ENABLED_CHANNELS=all,!clws

# ---------------------------------------------------------------------------
# Shared channel config
# ---------------------------------------------------------------------------
# Optional overrides:
# ANN_TOPIC=com_announcement_en
# ANN_RECV_WINDOW_MS=30000
# Catalog IDs to monitor (default: 48 = New Cryptocurrency Listing).
# Known categories:
#   48  -> New Cryptocurrency Listing
#   49  -> Latest Binance News
#   50  -> Latest Activities
#   51  -> Delistings
#   93  -> Latest Activities (alt)
#   128 -> P2P Merchant Announcements
#   157 -> Margin / Futures listings
#   161 -> Earn / Staking
# Set to 0 to monitor ALL announcement categories.
# ANN_CATALOG_IDS=48,49,50,51,93,128,157,161

# ---------------------------------------------------------------------------
# Telegram notifications (optional — notifier is a no-op if unset).
# ---------------------------------------------------------------------------
# Create a bot via @BotFather, then get chat id (negative for groups).
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# TELEGRAM_CHAT_ID=-1001234567890

# ---------------------------------------------------------------------------
# Per-channel config (optional — all have safe defaults)
# ---------------------------------------------------------------------------

# CMS apex poller (fallback channel).
# Base interval between poll cycles (seconds). Lower = more aggressive.
# CMS_POLL_INTERVAL_S=2.0
# Fast interval used during a burst after a Miss/RefreshHit (seconds).
# CMS_POLL_FAST_INTERVAL_S=0.5
# Number of fast cycles per burst trigger.
# CMS_POLL_FAST_CYCLES=4
# Comma-separated cache statuses that trigger a fast burst.
# Options: Miss, RefreshHit (default: both).
# CMS_ADAPTIVE_TRIGGERS=Miss,RefreshHit
# STATS log every N cycles (default 100; lower = more verbose).
# CMS_STATS_EVERY_CYCLES=100

# exchangeInfo poller (backup channel).
# Polls Binance market-data API for new trading symbols. Uses three hosts
# in parallel: api.binance.com (CloudFront), api-gcp.binance.com (GCP GLB),
# api4.binance.com (direct nginx origin, no CloudFront).
# EI_POLL_INTERVAL_S=2.0
# EI_HOSTS=api.binance.com,api-gcp.binance.com,api4.binance.com
# EI_STATS_EVERY_CYCLES=100

# Ticker sniper (tradable-now signal).
# Polls GET /api/v3/ticker/price (lightweight ~150KB vs 17MB exchangeInfo)
# at high frequency and detects new tradable symbols by diffing the set.
# Default 1000ms (1 Hz) — conservative start. Tune aggressively once no 429
# in production: 100ms (10 Hz), 50ms (20 Hz), 10ms (100 Hz).
# SNIPER_POLL_INTERVAL_MS=1000
# SNIPER_HOSTS=api4.binance.com,api.binance.com,api-gcp.binance.com
# SNIPER_MAX_429_BACKOFF_S=60
# SNIPER_STATS_EVERY_CYCLES=100

# CMS composite poller (comparison channel).
# Polls alternative CMS path /bapi/composite/v1/public/cms/article/catalog/list/query
# with random pageSize (10..49) cache-buster. 60s interval (Binance IP-ban
# threshold for CMS endpoints). Shares ANN_CATALOG_IDS with cms_apex_poller.py.
# COMPOSITE_POLL_INTERVAL_S=60.0
# COMPOSITE_STATS_EVERY_CYCLES=10

# CryptoListing.ws client (co-located benchmark).
# Get keys via Telegram @CLWfeed. Two free tiers:
#   SpeedTrial: 0ms delay, title/ticker REDACTED (benchmark only, tag CLWS)
#   FreeDelayed: +240ms delay, full payload (auxiliary feed, tag CLWD)
# CL_SPEEDTRIAL_TOKEN=dsk_your_speedtrial_key_here
# CL_FREEDELAYED_TOKEN=dsk_your_freedelayed_key_here
# CL_TIERS=both                # both, speedtrial, freedelayed
# CL_TEST=false                # send {"type":"test"} 15s after welcome
# CL_CEX=binance               # comma-separated: binance,upbit,bithumb
# CL_ENDPOINT=wss://cryptolisting.ws
# SMOKE_SECONDS=120
